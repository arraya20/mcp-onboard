{
  "name": "docs-mcp-onboarding",
  "version": "1.0.0",
  "type": "module",
  "description": "Onboards onto Pharos using only the Developer Docs MCP, logs every query and answer, and cross-checks the gaps against a pinned docs snapshot.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:index": "node scripts/build-index.mjs",
    "audit": "node scripts/audit.mjs",
    "audit:live": "node scripts/audit.mjs --live",
    "test": "node test/offline.test.mjs && node test/claims.test.mjs && node test/api.test.mjs && node scripts/mcp-session.mjs --check",
    "verify:claims": "node scripts/verify-claims.mjs",
    "test:live": "node test/live.test.mjs",
    "serve": "npx --yes wrangler pages dev public --port 8793 --ip 127.0.0.1",
    "deploy": "npx --yes wrangler pages deploy public",
    "mcp:session": "node scripts/mcp-session.mjs",
    "mcp:render": "node scripts/mcp-session.mjs --render",
    "mcp:check": "node scripts/mcp-session.mjs --check"
  },
  "keywords": [
    "pharos",
    "documentation",
    "developer-experience",
    "mcp"
  ],
  "license": "MIT",
  "files": [
    "src",
    "scripts",
    "functions",
    "public",
    "data",
    "docs",
    "reports",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "wrangler.toml"
  ],
  "author": "arraya20",
  "homepage": "https://mcp-onboard.nampharos.web.id",
  "repository": {
    "type": "git",
    "url": "https://github.com/arraya20/mcp-onboard.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
